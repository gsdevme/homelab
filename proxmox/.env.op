# 1Password references, not values: safe to commit. `op run` swaps each one
# for the real value in tofu's environment only.
#
#   op run --env-file=.env.op -- tofu plan
#
PROXMOX_VE_ENDPOINT=op://proxmox/proxmox-opentofu/endpoint
PROXMOX_VE_API_TOKEN=op://proxmox/proxmox-opentofu/api-token
TF_VAR_ssh_public_key="op://proxmox/proxmox-guest-root/public key"
